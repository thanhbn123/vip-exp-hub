# VIP Express Hub — MẪU .env cho VPS. CHÉP thành .env (cùng thư mục compose), chmod 600.
# KHÔNG commit .env. KHÔNG đặt mật khẩu BEST, token, passphrase vào đây.
#
# Tệp này được track bằng ngoại lệ trong trien_khai/vps/.gitignore (root .gitignore chặn
# `.env.*`). Nó chỉ chứa tên biến + giá trị giả/không bí mật.
#
# URL công khai của webhook. Phải khớp tên miền Caddy và DNS đã trỏ về VPS.
VIP_HUB_PUBLIC_BASE_URL=https://best-uat.viporder.vn
#
# Cổng phê duyệt thao tác BEST thật. Mặc định 0 = mọi thao tác thật bị 403.
# Chỉ đặt 1 + mã audit trong cửa sổ Owner nghiệm thu sandbox; gỡ sau khi xong.
VIP_BEST_OWNER_APPROVED=0
VIP_BEST_OWNER_APPROVAL_ID=
#
# Proxy tin cậy để đọc X-Forwarded-For. Để TRỐNG lượt đầu; sau khi đo log có thể điền
# IP gateway Docker mà app THẬT SỰ thấy (không phải 127.0.0.1 nếu dùng port mapping).
# Không tin dải rộng nếu không đo.
VIP_HUB_PROXY_TIN_CAY=
#
# UID/GID của user `deploy` trên VPS (đo 2026-10-19: 1000:1000). Phải khớp chủ sở hữu
# /home/deploy/vip-express-hub/data và build args của image; `docker compose config` sẽ
# in ra giá trị thực. Đổi ở đây thì phải build lại image.
VIP_HUB_UID=1000
VIP_HUB_GID=1000
#
# Tag image; đổi theo commit đã duyệt. Không dùng latest.
VIP_HUB_IMAGE_TAG=2026-10-19
